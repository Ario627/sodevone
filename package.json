{
  "name": "kelas-xi-pplg-1",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo Website Kelas XI PPLG 1",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "pnpm": ">=12.16.1"
  },
  "scripts": {
    "setup": "pnpm install && pnpm run build:packages",
    "build": "pnpm run build:packages && pnpm --filter \"./apps/*\" build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "dev": "pnpm run build:packages && pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @kelas/web dev",
    "dev:api": "pnpm --filter @kelas/api dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "clean": "pnpm -r exec rm -rf dist .angular"
  },
  "devDependencies": {
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
